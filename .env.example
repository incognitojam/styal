# Optional: styal Link source builds
# `cp .env.example .env` enables styal Link.
# These are the same public identifiers baked into official builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Optional runtime state override. The default is ~/.styal.
# STYAL_HOME=/absolute/path/to/styal-data

T3CODE_RELAY_URL=https://relay.styal.build

# Optional: styal-owned Expo project. Without both values, mobile OTA updates are
# disabled so a source build can never join T3 Code's update stream.
# EXPO_OWNER=<styal Expo account>
# EXPO_PROJECT_ID=<styal Expo project UUID>
# Entitlement-capable non-interactive iOS builds also require styal's Apple team.
# APPLE_TEAM_ID=<Apple Developer Team ID for signed styal mobile builds>

