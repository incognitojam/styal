# styal Link against the development Clerk instance, for local source builds
# (`vp run dev`, `vp run dev:desktop`). Copy to `.env` or `.env.local`. These are
# public identifiers, not secrets. Do not add server-side secrets to this file.
# See docs/operations/styal-link.md.

T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_cHJpbWFyeS1mYXduLTY3MzMuY2xlcmsuYWNjb3VudHMuZGV2JA
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=uekbG5swJmSdN2fw

# Shared development relay, deployed from main alongside production. It trusts
# the development Clerk instance. To test relay changes before they merge,
# deploy a personal stage instead (`vp run --filter t3code-relay deploy`), which
# writes its own URL to the root `.env`.
T3CODE_RELAY_URL=https://relay-dev.styal.build
