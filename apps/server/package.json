{
  "name": "@styal/cli",
  "version": "0.0.35",
  "description": "Run the styal server and web client for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/incognitojam/styal",
    "directory": "apps/server"
  },
  "bin": {
    "styal": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build:bundle": "vp pack",
    "start": "node dist/bin.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run",
    "test:nightly-upgrade": "node scripts/verify-nightly-schema-upgrade.ts",
    "build:exe": "node scripts/cli.ts build-exe"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.170",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@opencode-ai/sdk": "^1.3.15",
    "@pierre/diffs": "catalog:",
    "effect": "catalog:",
    "msgpackr-extract": "3.0.4",
    "node-pty": "^1.1.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/node": "catalog:",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
